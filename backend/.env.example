# Windows pe "localhost" ki jagah 127.0.0.1 hi likho (Node kabhi kabhi localhost ko IPv6 ::1 pe bhej deta hai)
MONGO_URL=mongodb://127.0.0.1:27017/redis_demo
REDIS_URL=redis://127.0.0.1:6379
PORT=4000

# Kitne seconds tak cache valid rahega
CACHE_TTL=60

# Seed script kitne students daalegi
SEED_COUNT=50000
